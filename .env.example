# OPENROUTER_API_KEY: Required for OpenRouter API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Settings menu.
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Required only when Gemini-backed chat models are used.
GEMINI_API_KEY=""

# PUTER_AUTH_TOKEN: Optional authentication token for the self-repair provider.
PUTER_AUTH_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Brevo Transactional Email Configuration
# You must provide a valid Brevo API key to enable real email OTP delivery.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="karishma.ai@outlook.com"
